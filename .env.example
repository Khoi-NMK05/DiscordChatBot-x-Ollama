# Discord Bot Credentials (Required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Ollama Model & Host Configuration (Optional)
OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_HOST=http://localhost:11434

# Bot Behavior & Memory Settings (Optional)
BOT_COMMAND_PREFIX=!
MAX_HISTORY_TURNS=15
PRESENCE_TEXT=@ me to chat!
SEPARATE_MESSAGES=true
MESSAGE_DELAY=0.8

# LLM Generation Hyperparameters (Optional)
TEMPERATURE=0.80
TOP_P=0.90
MIN_P=0.07
REPEAT_PENALTY=1.08
NUM_PREDICT=2048
NUM_CTX=8192

# Vision Configuration (Decoupled Pipeline, Optional)
VISION_ENABLED=true
VISION_MODEL=qwen2.5vl:3b
VISION_MAX_DIMENSION=1536
VISION_NUM_PREDICT=1024
VISION_PROMPT=Analyze and describe this image in detail. If there is visible text, handwriting, signs, documents, or math problems, accurately transcribe and summarize the text. Identify subjects, objects, and key visual details clearly.


